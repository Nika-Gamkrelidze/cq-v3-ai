# Local development overrides for the Next frontend.
# Copy to .env.local and edit. Not needed to build or deploy: every value here has a
# production-correct default.
#
# .env.local is ignored by `.env*.local` in this directory's .gitignore — and it needs that own
# line, because the repo-root .gitignore's `.env` and `*.env` match NEITHER `.env.local`
# (`*.env` wants a name ENDING in .env). This repo is public; check the line is still there
# before you put anything in the file.
#
# NO SECRETS BELONG IN THIS FILE. Anything prefixed NEXT_PUBLIC_ is inlined into the JavaScript
# bundle at build time and is readable by every visitor. API keys and passwords live in the
# repo-root .env, which only the backend reads.

# Where the API lives. Defaults to '/api', which is correct in production: nginx serves the
# exported pages and proxies /api/ to the FastAPI container on the same origin, so there is no
# CORS to configure and the browser never learns the backend's address.
#
# Set this ONLY for `npm run dev`. The dev server is its own origin (http://localhost:3000) with
# no proxy in front of it, so the default '/api' resolves to http://localhost:3000/api and 404s
# every call. Point it at the API container instead — the compose override publishes it on 8000:
#
#   NEXT_PUBLIC_API_BASE=http://localhost:8000
#
# The backend must allow that origin in CORS for the browser to accept the responses.
# A trailing slash is stripped, so with or without one works.
NEXT_PUBLIC_API_BASE=http://localhost:8000
